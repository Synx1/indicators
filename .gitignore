node_modules
bot.pid
bot.log
state.json

# ── secrets: never committed ──
#
# The Discord bot token and the Kalshi key-store secret. .env.local is read at boot for local
# runs; on Railway these are service environment variables and this file does not exist.
# Listed BEFORE either file is created, so there is no window in which a token is trackable.
.env
.env.local
.env.*.local

# Encrypted Kalshi credentials, if the store is ever pointed inside the repo. It should not be
# (default is ~/.indicbot/users) but a mistaken KEY_DIR must not become a committed private key.
keys/
*.enc
bot-panel.log
users.json
globals.json
licences.json

# corpus2 raw data: 130 MB and fully regenerable by research/corpus2/fetch-*.js.
# The small result files (evaluation/decisions/residual) ARE tracked — they are the evidence.
research/corpus2/features.json
research/corpus2/oos-predictions.json
research/corpus2/candles/
research/corpus2/markets.json
research/corpus2/books.json

# Raw research corpora. paths.jsonl is 8MB of per-minute Kalshi book history and grows toward ~35MB
# for the full 45,030 markets; it is refetchable with research/arb/paths.js and does not belong in git.
research/arb/paths.jsonl
research/arb/*.jsonl
